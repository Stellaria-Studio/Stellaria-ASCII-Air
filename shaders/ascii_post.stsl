// ASCII SKY WebGPU post pass.
// StSL is the source of truth. WGSL in public/shaders is generated.

[[vk::binding(0, 0)]] Texture2D<float4> sourceTexture;
[[vk::binding(1, 0)]] SamplerState sourceSampler;

struct VertexOut
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
};

[shader("vertex")]
VertexOut vertexMain(uint vertexId : SV_VertexID)
{
    float2 position = vertexId == 0 ? float2(-1.0, -1.0) :
                      vertexId == 1 ? float2( 3.0, -1.0) :
                                      float2(-1.0,  3.0);
    VertexOut output;
    output.position = float4(position, 0.0, 1.0);
    output.uv = float2(position.x * 0.5 + 0.5, 0.5 - position.y * 0.5);
    return output;
}

[shader("fragment")]
float4 fragmentMain(VertexOut input) : SV_Target
{
    float2 uv = input.uv;
    float3 source = sourceTexture.Sample(sourceSampler, uv).rgb;
    float luminance = dot(source, float3(0.2126, 0.7152, 0.0722));
    float scanline = 0.92 + 0.08 * sin(input.position.y * 3.14159265);
    float2 centered = uv * 2.0 - 1.0;
    float vignette = saturate(1.05 - dot(centered, centered) * 0.24);
    float phosphor = max(luminance, source.g * 0.92);
    float3 terminal = float3(phosphor * 0.28, phosphor, phosphor * 0.57);
    // Preserve weapon amber/yellow and warning red while applying the green
    // phosphor response to neutral/green scene information.
    float alertChroma = saturate((source.r - source.b - 0.035) * 3.2);
    float3 color = lerp(terminal, source * 1.06, alertChroma);
    return float4(color * scanline * vignette, 1.0);
}
